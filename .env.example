# Core App Configuration
PORT=3000

# Database Configuration
# - For Supabase connection pooling, use the Transaction Pooler connection string (port 6543)
# - For direct local docker-compose connection, use the default port 5433
DATABASE_URL="postgresql://sentinel_user:sentinel_password@localhost:5433/sentinel_db?schema=public"
DIRECT_URL="postgresql://sentinel_user:sentinel_password@localhost:5433/sentinel_db?schema=public"

# Redis Queue Configuration
REDIS_URL="redis://localhost:6379"

# Python PII Microservice Configuration (TCP)
# - Use 'localhost' if running NestJS and python server directly on host
# - Use 'pii-service' if running within docker network cluster
PII_SERVICE_HOST=localhost
PII_SERVICE_PORT=50051
